{
  "manifestVersion": 2,
  "id": "claude-memory",
  "name": "Claude Memory",
  "version": "0.1.0",
  "description": "What Claude Code remembers about your project, and what no longer holds: memories citing deleted code, broken links, entries Claude cannot see. Read any memory in place; hand the fixes to Claude.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "claude-memory",
        "title": "Claude Memory",
        "icon": "book",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "settings": [
      {
        "key": "projectsRoot",
        "title": "Claude projects folder",
        "description": "Leave empty for ~/.claude/projects.",
        "type": "string",
        "default": ""
      }
    ]
  },
  "capabilities": [
    {
      "kind": "settings:own"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "terminal:send"
    },
    {
      "kind": "agent:launch"
    }
  ]
}
