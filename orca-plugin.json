{
  "manifestVersion": 2,
  "id": "claude-memory",
  "name": "Claude Memory",
  "version": "0.3.0",
  "description": "What Claude Code remembers about the project in front of you, and what no longer holds: memories citing deleted code, broken links, entries Claude cannot see. Read any memory in place; hand the fixes to a new Claude.",
  "license": "MIT",
  "homepage": "https://github.com/PierreB40/claude-memory",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "claude-memory",
        "title": "Claude Memory",
        "icon": "book",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "settings": [
      {
        "key": "projectsRoot",
        "title": "Claude projects folder",
        "description": "Leave empty for ~/.claude/projects.",
        "type": "string",
        "default": ""
      }
    ],
    "commands": [
      {
        "id": "show",
        "title": "Claude Memory : afficher ou masquer la barre latérale"
      },
      {
        "id": "verify",
        "title": "Claude Memory : faire vérifier la mémoire par Claude",
        "when": "workspace"
      }
    ],
    "statusBarItems": [
      {
        "id": "health",
        "icon": "book",
        "text": " ",
        "tooltip": "Mémoire de Claude",
        "command": "show"
      }
    ],
    "events": [
      {
        "on": "workspace.changed"
      }
    ],
    "hooks": [
      {
        "event": "agent.tool.after"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "settings:own"
    },
    {
      "kind": "storage:own"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "terminal:send"
    },
    {
      "kind": "notifications:show"
    }
  ]
}
