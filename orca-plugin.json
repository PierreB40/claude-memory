{
  "manifestVersion": 2,
  "id": "claude-memory",
  "name": "Claude Memory",
  "version": "0.4.1",
  "description": "What Claude Code remembers about the project in front of you, and what no longer holds: memories citing deleted code, broken links, entries Claude cannot see. Read any memory in place; hand the fixes to a new Claude.",
  "author": {
    "name": "Pierre Blanchard",
    "url": "https://github.com/PierreB40"
  },
  "repository": "https://github.com/PierreB40/claude-memory",
  "license": "MIT",
  "homepage": "https://github.com/PierreB40/claude-memory",
  "icon": "assets/icon.png",
  "cover": {
    "path": "assets/cover.png",
    "alt": "The panel listing memories to verify: a deleted file in the index, a broken link, a cited file not found, one to update at merge."
  },
  "screenshots": [
    {
      "path": "assets/screenshot.png",
      "alt": "The panel’s three tabs side by side: memories to verify, what Claude learned this week, and every memory grouped by type.",
      "caption": "To verify, Recent and All, on a demo project"
    }
  ],
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "claude-memory",
        "title": "Claude Memory",
        "icon": "book",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "settings": [
      {
        "key": "projectsRoot",
        "title": "Claude projects folder",
        "description": "Leave empty for ~/.claude/projects.",
        "type": "string",
        "default": ""
      }
    ],
    "commands": [
      {
        "id": "show",
        "title": "Claude Memory: Show or Hide the Sidebar"
      },
      {
        "id": "verify",
        "title": "Claude Memory: Have Claude Verify the Memory",
        "when": "workspace"
      }
    ],
    "statusBarItems": [
      {
        "id": "health",
        "icon": "book",
        "text": " ",
        "tooltip": "Claude’s memory",
        "command": "show"
      }
    ],
    "events": [
      {
        "on": "workspace.changed"
      },
      {
        "on": "agent.status.changed"
      }
    ],
    "hooks": [
      {
        "event": "agent.tool.after"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "settings:own"
    },
    {
      "kind": "storage:own"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "agent:launch"
    },
    {
      "kind": "terminal:send"
    },
    {
      "kind": "notifications:show"
    }
  ]
}
